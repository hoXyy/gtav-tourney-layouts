{
  "name": "gtav-tourney-layouts",
  "version": "2.0.0",
  "description": "Layouts used for Summer Segments Scramble 2.",
  "homepage": "https://github.com/hoXyy/gtav-tourney-layouts#readme",
  "bugs": {
    "url": "https://github.com/hoXyy/gtav-tourney-layouts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoXyy/gtav-tourney-layouts.git"
  },
  "license": "MIT",
  "author": "hoXyy",
  "scripts": {
    "autofix": "run-s autofix:*",
    "autofix:browser": "eslint --fix --ext .ts,.vue src/dashboard && eslint --fix --ext .ts,.vue src/graphics",
    "autofix:extension": "eslint --fix --ext .ts src/extension && eslint --fix --ext .d.ts src/types",
    "prebuild": "npm run clean",
    "build": "run-s clean build:*",
    "build:browser": "vite build",
    "build:extension": "tsc -b tsconfig.extension.json",
    "clean": "trash node_modules/.cache && trash shared/dist && trash dashboard && trash graphics && trash extension",
    "lint": "run-s lint:*",
    "lint:browser": "eslint --ext .ts,.vue src/dashboard && eslint --ext .ts,.vue src/graphics",
    "lint:extension": "eslint --ext .ts src/extension && eslint --ext .d.ts src/types",
    "schema-types": "nodecg schema-types",
    "start": "node ../..",
    "watch": "run-p watch:*",
    "watch:browser": "vite",
    "watch:extension": "tsc -b tsconfig.extension.json -w"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "fitty": "^2.3.6",
    "image-to-base64": "^2.2.0",
    "klona": "^2.0.6",
    "livesplit-core": "^0.10.2",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.2",
    "node-fetch": "^2.7.0",
    "obs-websocket-js": "^5.0.5",
    "stream-mime-type": "^1.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nodecg/types": "^2.1.12",
    "@quasar/extras": "^1.15.11",
    "@quasar/vite-plugin": "^1.3.0",
    "@types/image-to-base64": "^2.1.2",
    "@types/node": "^18.14.6",
    "@types/node-fetch": "^2.6.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vueuse/head": "^1.1.15",
    "eslint": "^8.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-vue": "^9.9.0",
    "nodecg-cli": "^8.6.0",
    "nodecg-types": "^1.9.0",
    "nodecg-vue-composable": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "quasar": "^2.11.7",
    "trash-cli": "^5.0.0",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "vite-plugin-checker": "^0.5.6",
    "vite-plugin-nodecg": "^2.0.0-rc2",
    "vue": "^3.2.47",
    "vue-eslint-parser": "^9.1.0",
    "vue-tsc": "^1.2.1"
  },
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "dashboardPanels": [
      {
        "name": "commentators",
        "title": "Commentators",
        "file": "commentators.html",
        "width": 3
      },
      {
        "name": "prize-pool",
        "title": "Prize Pool",
        "file": "prize-pool.html",
        "width": 2
      },
      {
        "name": "player-pb",
        "title": "Player PBs",
        "file": "player-pb.html",
        "width": 2
      },
      {
        "name": "timer",
        "title": "Timer",
        "file": "timer.html",
        "width": 3
      },
      {
        "name": "streamAssign",
        "title": "Stream Assign",
        "file": "streamAssign.html",
        "width": 3
      },
      {
        "name": "matches",
        "title": "List of matches",
        "file": "matches.html",
        "width": 3
      },
      {
        "name": "pick-ban",
        "title": "Segment Pick/Ban",
        "file": "pick-ban.html",
        "width": 3
      },
      {
        "name": "current-segment",
        "title": "Current Segment",
        "file": "current-segment.html",
        "width": 2
      },
      {
        "name": "add-edit-match",
        "title": "Add/Edit Match",
        "file": "add-edit-match.html",
        "width": 6,
        "dialog": true,
        "dialogButtons": [
          {
            "name": "save",
            "type": "confirm"
          },
          {
            "name": "cancel",
            "type": "dismiss"
          }
        ]
      }
    ],
    "graphics": []
  }
}
